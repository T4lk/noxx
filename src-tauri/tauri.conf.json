{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noxx",
  "version": "0.1.12",
  "identifier": "dev.riffrs.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "noxx",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#070707",
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AudioServiceOutOfProcess,Translate,MediaRouter,OptimizationHints --enable-features=NetworkServiceInProcess2 --autoplay-policy=no-user-gesture-required --disable-gpu --in-process-gpu --disable-background-networking --disable-component-update --disable-crash-reporter --disable-breakpad --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Fast music player for SoundCloud, YouTube and YouTube Music",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RTE4MjhDQTMxNUFGRjgKUldUNHJ4V2pqSUxobGZGYzFWdFhySmw5TEVwVWZQOEZvK2dCOVErbDl2VkxQSTlkL0Y3WGlRYnMK",
      "endpoints": [
        "https://github.com/T4lk/noxx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
